# Copy to .env and set a value for every secret before the first start.
# .env is git-ignored and must never be committed. Generate the password with:
#   python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(24)))"
#
# Public port for NGINX on the host loopback (8080 before the video, 8090 after).
PUBLIC_PORT=8080

# PostgreSQL credentials. POSTGRES_PASSWORD is consumed both by the postgres
# service and by the DATABASE_URL handed to the app, so there is exactly one
# copy of the secret and the two can no longer drift apart.
POSTGRES_DB=barq_tasks
POSTGRES_USER=barq_app
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_FIRST_START

# Cosmetic banner returned by GET /
APP_MESSAGE=Welcome to BARQ Systems
